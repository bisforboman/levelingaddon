root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,toml,csproj,slnx}]
indent_size = 2

[*.cs]
# A braced case body lines up with its `case` label, the way the collector is written.
csharp_indent_case_contents_when_block = false
