{
  // Primary source for quest givers, turn-ins, coordinates, objectives and relations.
  // Data derived from it is GPLv3; see README.md.
  "questieDb": {
    "repository": "https://github.com/Questie/QuestieDB",
    "commit": "4b68257edd02998f6c9c6e8122e2205f05fc132e"
  },

  // Flight points and flight times (#16): Data/Taxi.lua of this repository, GPL-3.0-or-later,
  // with InFlight's measured times (MIT); see README.md. Pinned like QuestieDB, but under other
  // key names, because the nightly update finds QuestieDB's pin by "repository" and "commit".
  "taxi": {
    "source": "https://github.com/cjber/shortest-path-forever",
    "revision": "bc9eaa96154c319a3ab7ef30433e73b2c6b86839"
  },

  // JSON -> Lua export. Files fill ns.<table>.quests, ns.<table>.npcs, ... in the addon's private
  // namespace. Lua 5.1 refuses a file with more than 262,143 distinct literals, so a table is split
  // across numbered files before it reaches maxConstantsPerFile.
  //
  // Spawn reduction, per NPC or object and zone. A zone's list with at most spawnMergeAbove points
  // is exported exactly. In a longer list, a point within spawnMergeDistance (percent of the zone
  // map) of a point already kept is merged into that one. First guesses, to be tuned in game.
  "export": {
    "table": "Data",
    "maxConstantsPerFile": 200000,
    "spawnMergeAbove": 10,
    "spawnMergeDistance": 2,

    // Class spells worth a trainer visit of their own (#17): the addon counts one 3, any other
    // spell 1. The mark goes on a spell's first purchase only (its rank 1 row, or its only row
    // when it has no ranks), so a spell whose rank 1 is a starting spell cannot be listed. A
    // name that matches no such row stops the export. Picked from memory of Classic, to be
    // tuned in game; this server's own spells are not judged.
    "classSpellKeys": {
      "DRUID": ["Rejuvenation", "Entangling Roots", "Regrowth", "Swipe", "Cat Form", "Claw", "Rip", "Ferocious Bite", "Travel Form", "Dire Bear Form", "Innervate"],
      "HUNTER": ["Serpent Sting", "Arcane Shot", "Concussive Shot", "Aspect of the Hawk", "Mend Pet", "Wing Clip", "Multi-Shot", "Aspect of the Cheetah", "Freezing Trap", "Feign Death"],
      "MAGE": ["Frostbolt", "Conjure Water", "Polymorph", "Frost Nova", "Arcane Explosion", "Blink", "Blizzard", "Evocation", "Counterspell", "Cone of Cold"],
      "PALADIN": ["Blessing of Might", "Judgement", "Hammer of Justice", "Lay on Hands", "Retribution Aura", "Consecration", "Flash of Light", "Blessing of Kings", "Divine Shield"],
      "PRIEST": ["Shadow Word: Pain", "Power Word: Shield", "Renew", "Mind Blast", "Inner Fire", "Psychic Scream", "Flash Heal", "Greater Heal"],
      "ROGUE": ["Gouge", "Evasion", "Sprint", "Slice and Dice", "Kick", "Vanish", "Cheap Shot", "Kidney Shot", "Blind"],
      "SHAMAN": ["Earth Shock", "Lightning Shield", "Flametongue Weapon", "Flame Shock", "Ghost Wolf", "Frost Shock", "Lesser Healing Wave", "Windfury Weapon", "Chain Lightning", "Astral Recall"],
      "WARLOCK": ["Corruption", "Life Tap", "Bane of Agony", "Fear", "Drain Soul", "Drain Life", "Create Healthstone", "Demon Armor", "Death Coil"],
      "WARRIOR": ["Charge", "Rend", "Thunder Clap", "Hamstring", "Bloodrage", "Overpower", "Cleave", "Execute", "Berserker Rage", "Whirlwind"]
    }
  },

  // Secondary source, fetched only by you, on your own machine.
  "wowhead": {
    "userAgent": "quest-data-collector/0.1",
    "delaySeconds": 5,
    "jitterSeconds": 3,
    "maxConsecutiveFailures": 3,
    // The total the quest listing showed on 2026-11-14; the validation report compares against it.
    "reportedQuestCount": 6138,
    // "chrome" or "msedge": the browser installed on your machine.
    "browserChannel": "chrome",

    "kinds": {
      // Site pages sit behind a browser check, so these open a visible browser window.
      "quest": { "url": "https://www.wowhead.com/forever/quest={id}", "source": "browser" },
      "list": { "source": "browser" },
      // One ability listing per class; the addresses are in tools/collector/class-spells.txt.
      // A page on which the "spells" capture below finds nothing stops the run and is not cached.
      "class-spells": { "source": "browser", "requiredCapture": "spells" },

      // Tooltip JSON, served to plain HTTP clients.
      "npc-tooltip": { "url": "https://nether.wowhead.com/forever/tooltip/npc/{id}", "source": "http" },
      "quest-tooltip": { "url": "https://nether.wowhead.com/forever/tooltip/quest/{id}", "source": "http" }
    },

    // Evaluated on each browser page; a null result is not stored.
    "browserCaptures": {
      "listview": "JSON.stringify(window.g_listviews && window.g_listviews.quests ? window.g_listviews.quests.data : null)",
      "spells": "JSON.stringify(window.g_listviews && window.g_listviews.spells ? window.g_listviews.spells.data : null)"
    }
  }
}
